{
  "name": "nora",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/agent",
    "packages/shared"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "bun node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "bun test packages/agent/test/",
    "check": "bun scripts/check.mjs",
    "test:node": "npm run build && node --test dist/agent/test/*.test.js",
    "agent": "npm run build && node --env-file-if-exists=.env.local dist/agent/src/cli.js",
    "agent:server": "node dist/agent/src/server.js",
    "agent:confirmation-demo-server": "node dist/agent/src/confirmation-demo-server.js",
    "helper:package-app": "sh apps/macos-helper/scripts/package_app.sh",
    "jev:smoke": "npm run build && node --env-file-if-exists=.env.local dist/agent/src/jev-smoke.js",
    "jev:demo": "npm run build && node --env-file-if-exists=.env.local dist/agent/src/jev-demo.js",
    "jev:native-smoke": "npm run build && node --env-file-if-exists=.env.local dist/agent/src/native-jev-smoke.js"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
